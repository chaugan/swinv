# Build output. Anchored to the repo root so that cmd/swinv/ - the source
# directory, which is also called swinv - is never ignored.
/bin/
/dist/
/swinv
/swinv.exe
/swinv-*-linux-*
/swinv-*-windows-*

# GOOS=windows go build ./cmd/... writes swinv.exe into whatever directory it
# is run from, which is how a 109 MB binary once reached a commit and was
# rejected by the remote. Ignore it wherever it lands, not only at the root.
swinv.exe

# Test and coverage artefacts
coverage.out
coverage.html
coverage.txt
*.test
*.prof
*.pprof

# Local inventory output - never commit a real host's inventory.
/inventory/
/out/
*.tmp-*
*-latest.json
*-latest.csv
*-latest.ndjson
*-latest.cdx.json

# Golden fixtures and their expected output are deliberately checked in, so
# nothing under testdata/ is ignored.
!testdata/**

# Not part of swinv. A Lance vector index and a TF-IDF pickle were written here
# by unrelated local tooling before the project existed; they have since been
# deleted. The rule stays as a guard: if that tooling runs again it recreates
# the directory, and nothing about it belongs in this repository.
/vectors/

# Editor / OS noise
.idea/
.vscode/
*.swp
*~
.DS_Store
